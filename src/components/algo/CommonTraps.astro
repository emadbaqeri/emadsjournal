---
interface Props {
  wrong: string;
  right: string;
}
const { wrong, right } = Astro.props;
---
<div class="trap">
  <div class="trap-wrong">
    <p class="text-mono-eyebrow">Trap</p>
    <pre data-code-scroll>{wrong}</pre>
  </div>
  <div class="trap-right">
    <p class="text-mono-eyebrow">Fix</p>
    <pre data-code-scroll>{right}</pre>
  </div>
</div>
