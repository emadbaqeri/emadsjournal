---
import { Code } from 'astro-expressive-code/components';
import { getSolutionChoices } from '../../lib/algorithms/solutions';
import type { SolutionChoice } from '../../lib/algorithms/solution-choices';

interface Props {
  slug?: string;
  choices?: SolutionChoice[];
}

const { slug = '', choices = slug ? getSolutionChoices(slug) : [] } = Astro.props;
---
<section class="solution-tabs" data-solution-tabs>
  <div class="solution-head">
    <div class="viz-lang" role="group" aria-label="Approach and language">
      {choices.map((choice, index) => (
        <button
          type="button"
          data-solution-choice={choice.id}
          data-selected={index === 0 ? 'true' : 'false'}
          aria-pressed={index === 0 ? 'true' : 'false'}
        >
          {choice.label}
        </button>
      ))}
    </div>
  </div>
  <div class="solution-stage" data-solution-stage data-bottom-fade="on">
    {choices.map((choice, index) => (
      <div class="solution-code" data-panel={choice.id} hidden={index !== 0}>
        <div class="solution-scroll" data-solution-scroll>
          <Code code={choice.code} lang={choice.lang} title={choice.filename} />
        </div>
      </div>
    ))}
    <div class="solution-fade" aria-hidden="true"></div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-solution-tabs]').forEach((root) => {
    if (root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';
    const buttons = root.querySelectorAll<HTMLButtonElement>('[data-solution-choice]');
    const panels = root.querySelectorAll<HTMLElement>('[data-panel]');
    const stage = root.querySelector<HTMLElement>('[data-solution-stage]');

    const selected = () => root.querySelector<HTMLElement>('[data-panel]:not([hidden])');
    const scrollerOf = (panel: HTMLElement | null) =>
      panel?.querySelector<HTMLElement>('[data-solution-scroll]') ?? null;

    const syncScroll = (scroller: HTMLElement | null) => {
      if (!scroller || !stage) return;
      const maxY = scroller.scrollHeight - scroller.clientHeight;
      const more = maxY > 8 && scroller.scrollTop < maxY - 8;
      stage.dataset.bottomFade = more ? 'on' : 'off';
      const overflows =
        scroller.scrollHeight > scroller.clientHeight + 1 ||
        scroller.scrollWidth > scroller.clientWidth + 1;
      if (overflows) {
        if (!scroller.hasAttribute('tabindex')) {
          scroller.tabIndex = 0;
          scroller.dataset.tabindexAdded = 'true';
        }
      } else if (scroller.dataset.tabindexAdded === 'true') {
        scroller.removeAttribute('tabindex');
        delete scroller.dataset.tabindexAdded;
      }
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        buttons.forEach((item) => {
          const on = item === button;
          item.dataset.selected = on ? 'true' : 'false';
          item.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
        panels.forEach((panel) => {
          panel.hidden = panel.dataset.panel !== button.dataset.solutionChoice;
        });
        requestAnimationFrame(() => syncScroll(scrollerOf(selected())));
      });
    });

    panels.forEach((panel) => {
      const scroller = scrollerOf(panel);
      if (!scroller) return;
      const root = scroller.querySelector<HTMLElement>('.expressive-code');
      const frame = root?.querySelector<HTMLElement>('.frame');
      const pre = frame?.querySelector('pre');
      if (root && frame && pre && pre.parentElement !== scroller) {
        scroller.replaceWith(root);
        scroller.append(pre);
        frame.append(scroller);
      }
      scroller.addEventListener('scroll', () => syncScroll(scroller), { passive: true });
      if (typeof ResizeObserver !== 'undefined') {
        new ResizeObserver(() => syncScroll(scroller)).observe(scroller);
      }
    });

    const refresh = () => syncScroll(scrollerOf(selected()));
    refresh();
    document.fonts?.ready.then(refresh).catch(() => {});
  });
</script>
