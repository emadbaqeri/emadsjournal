---
import { PRIMARY_NAV, isCurrentPath } from '../../lib/site';
import ThemeToggle from './ThemeToggle.astro';
import styles from './SiteHeader.module.css';

const pathname = Astro.url.pathname;
---

<a class={styles.skip} href="#main">Skip to content</a>
<header class={styles.header}>
  <a class={styles.wordmark} href="/" aria-label="emad/journal home">
    <span class={styles.brand}>emad</span><span class={styles.slash}>/</span><span class={styles.name}>journal</span>
  </a>

  <nav class={styles.desktopNav} aria-label="Primary">
    {
      PRIMARY_NAV.map((item) => (
        <a
          class={styles.navLink}
          href={item.href}
          aria-current={isCurrentPath(pathname, item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))
    }
    <ThemeToggle />
  </nav>

  <details class={styles.menu} data-menu>
    <summary class={styles.menuToggle}>menu ≡</summary>
    <div class={styles.scrim} data-menu-scrim aria-hidden="true"></div>
    <nav class={styles.panel} aria-label="Primary">
      {
        PRIMARY_NAV.map((item) => (
          <a
            class={styles.navLink}
            href={item.href}
            aria-current={isCurrentPath(pathname, item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <ThemeToggle />
    </nav>
  </details>
</header>

<script>
  function bindMenus(): void {
    document.querySelectorAll<HTMLDetailsElement>('[data-menu]').forEach((menu) => {
      if (menu.dataset.menuBound === 'true') return;
      menu.dataset.menuBound = 'true';
      const summary = menu.querySelector('summary');
      const close = () => {
        if (!menu.open) return;
        menu.open = false;
        summary?.focus();
      };

      menu.querySelector('[data-menu-scrim]')?.addEventListener('click', close);
      menu.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          menu.open = false;
          summary?.focus();
        });
      });

      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape' || !menu.open) return;
        event.preventDefault();
        close();
      });

      document.addEventListener('click', (event) => {
        if (!menu.open) return;
        const target = event.target;
        if (!(target instanceof Node) || menu.contains(target)) return;
        close();
      });
    });
  }

  bindMenus();
  document.addEventListener('astro:page-load', bindMenus);
</script>
