---
import { PRIMARY_NAV, isCurrentPath } from '../../lib/site';
import ThemeToggle from './ThemeToggle.astro';
import styles from './SiteHeader.module.css';

const pathname = Astro.url.pathname;
---

<a class={styles.skip} href="#main">Skip to content</a>
<header class={styles.header}>
  <a class={styles.wordmark} href="/" aria-label="emad/journal home">
    <span class={styles.brand}>emad</span><span class={styles.slash}>/</span><span class={styles.name}>journal</span>
  </a>

  <nav class={styles.desktopNav} aria-label="Primary">
    {
      PRIMARY_NAV.map((item) => (
        <a
          class={styles.navLink}
          href={item.href}
          aria-current={isCurrentPath(pathname, item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))
    }
    <ThemeToggle />
  </nav>

  <details class={styles.menu} data-menu>
    <summary class={styles.menuToggle}>
      <span class={styles.menuOpenLabel}>menu ≡</span>
      <span class={styles.menuCloseLabel}>close ×</span>
    </summary>
    <div class={styles.scrim} data-menu-scrim aria-hidden="true"></div>
    <nav class={styles.panel} aria-label="Primary">
      <ol class={styles.sheetList}>
        {
          PRIMARY_NAV.map((item, index) => (
            <li>
              <a
                class={styles.sheetLink}
                href={item.href}
                aria-current={isCurrentPath(pathname, item.href) ? 'page' : undefined}
              >
                <span class={styles.sheetIndex}>{String(index + 1).padStart(2, '0')}</span>
                <span class={styles.sheetLabel}>{item.label}</span>
                <span class={styles.sheetArrow} aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
        <li class={styles.sheetTheme}>
          <span class={styles.sheetIndex}>{String(PRIMARY_NAV.length + 1).padStart(2, '0')}</span>
          <span class={styles.sheetLabel}>theme</span>
          <ThemeToggle variant="sheet" />
        </li>
      </ol>
    </nav>
  </details>
</header>

<script>
  const CLOSE_MS = 180;

  function bindMenus(): void {
    document.querySelectorAll<HTMLDetailsElement>('[data-menu]').forEach((menu) => {
      if (menu.dataset.menuBound === 'true') return;
      menu.dataset.menuBound = 'true';
      const summary = menu.querySelector('summary');
      let closing = false;

      const finish = () => {
        menu.open = false;
        delete menu.dataset.closing;
        closing = false;
        summary?.focus();
      };

      const close = () => {
        if (!menu.open || closing) return;
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce) {
          finish();
          return;
        }
        closing = true;
        menu.dataset.closing = 'true';
        window.setTimeout(finish, CLOSE_MS);
      };

      summary?.addEventListener('click', (event) => {
        if (!menu.open) return;
        event.preventDefault();
        close();
      });

      menu.querySelector('[data-menu-scrim]')?.addEventListener('click', close);
      menu.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          menu.open = false;
          delete menu.dataset.closing;
          closing = false;
          summary?.focus();
        });
      });

      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape' || !menu.open) return;
        event.preventDefault();
        close();
      });

      document.addEventListener('click', (event) => {
        if (!menu.open) return;
        const target = event.target;
        if (!(target instanceof Node) || menu.contains(target)) return;
        close();
      });
    });
  }

  bindMenus();
  document.addEventListener('astro:page-load', bindMenus);
</script>
