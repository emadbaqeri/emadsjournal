---
import styles from './Figure.module.css';

interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class={styles.figure}>
  <div class={styles.frame}>
    <slot />
  </div>
  <figcaption class:list={['text-mono-meta', styles.caption]}>{caption}</figcaption>
</figure>
