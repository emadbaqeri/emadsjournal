---
import type { Post } from '../../lib/content';
import { getPostPath, getSeriesNavParts } from '../../lib/content';
import { formatShortDate, plural, readingTimeMinutes } from '../../lib/format';
import PostTypeLabel from './PostTypeLabel.astro';
import Tag from './Tag.astro';
import styles from './PostCard.module.css';

interface Props {
  post: Post;
  headingLevel?: 'h2' | 'h3';
}

const { post, headingLevel = 'h2' } = Astro.props;
const path = getPostPath(post);
const date = formatShortDate(post.data.publishedAt);
const Heading = headingLevel;
const source = typeof post.body === 'string' ? post.body : post.data.description;
const minutes = readingTimeMinutes(`${post.data.title} ${post.data.description} ${source}`);
const topic = post.data.type === 'til' ? post.data.tags[0] : undefined;
const showExcerpt = post.data.type !== 'til';
const showTags = post.data.type === 'essay' || post.data.type === 'series-post';
const seriesTotal =
  post.data.type === 'series-post' && post.data.series
    ? (await getSeriesNavParts(post.data.series.id)).length
    : undefined;

const essayMeta = post.data.type === 'essay' ? ` · ${plural(minutes, 'min')} read` : '';
const seriesMeta =
  post.data.type === 'series-post' && post.data.seriesOrder && seriesTotal
    ? ` · part ${post.data.seriesOrder} of ${seriesTotal}`
    : '';
---

<article
  class:list={[styles.card, 'hit-rule', post.data.type === 'til' && styles.til]}
  data-track={post.data.track}
  data-feed-item
  data-type={post.data.type}
  data-track-id={post.data.track}
  data-tags={post.data.tags.join(',')}
>
  <div class={styles.metaRow}>
    <PostTypeLabel type={post.data.type} track={post.data.track} />
    <p class:list={['text-mono-meta', styles.meta]}>
      {post.data.type === 'build-log' && 'started '}
      <time datetime={post.data.publishedAt.toISOString()}>{date}</time>
      {essayMeta}
      {seriesMeta}
    </p>
    {topic && <span class:list={['text-mono-meta', styles.topic]}>#{topic}</span>}
  </div>
  <Heading class:list={['text-heading-h3', styles.title]}>
    <a href={path}>{post.data.title}</a>
  </Heading>
  {showExcerpt && <p class:list={['text-body-small', styles.excerpt]}>{post.data.description}</p>}
  {showTags && post.data.tags.length > 0 && (
    <p class={styles.tags}>
      {post.data.tags.map((tag) => (
        <Tag>{tag}</Tag>
      ))}
    </p>
  )}
</article>
