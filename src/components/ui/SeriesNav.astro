---
import type { SeriesEntry, SeriesNavPart } from '../../lib/content';
import styles from './SeriesNav.module.css';

interface Props {
  series: SeriesEntry;
  parts: SeriesNavPart[];
  variant?: 'list' | 'prev-next';
  currentId?: string;
}

const { series, parts, variant = 'list', currentId } = Astro.props;
const found = currentId ? parts.findIndex((part) => part.id === currentId) : -1;
const resolvedIndex = found >= 0 ? found : Math.max(parts.length - 1, 0);
const prev = resolvedIndex > 0 ? parts[resolvedIndex - 1] : undefined;
const next = resolvedIndex < parts.length - 1 ? parts[resolvedIndex + 1] : undefined;
const progressCount = parts.length === 0 ? 0 : resolvedIndex + 1;
---

{variant === 'list' ? (
  <section class={styles.list} data-track={series.data.track} aria-label={`${series.data.title} parts`}>
    <header class={styles.head}>
      <p class:list={['text-mono-eyebrow', styles.kicker]}>{series.data.title}</p>
      <p class:list={['text-mono-meta', styles.count]}>{progressCount} / {parts.length}</p>
    </header>
    <div class={styles.rail} aria-hidden="true">
      {parts.map((_, index) => (
        <span class:list={[styles.seg, index < progressCount && styles.segFilled]}></span>
      ))}
    </div>
    <ol class={styles.parts}>
      {parts.map((part, index) => {
        const state = index < resolvedIndex ? 'done' : index === resolvedIndex ? 'current' : 'upcoming';
        return (
          <li class:list={[styles.part, styles[state]]}>
            <span class:list={['text-mono-meta', styles.index]}>
              {String(part.order ?? index + 1).padStart(2, '0')}
            </span>
            <a
              class:list={['text-body-small', styles.partTitle]}
              href={part.href}
              aria-current={state === 'current' ? 'page' : undefined}
            >
              {part.title}
            </a>
          </li>
        );
      })}
    </ol>
  </section>
) : (
  (prev || next) && (
    <nav
      class:list={[styles.prevNext, !(prev && next) && styles.single]}
      data-track={series.data.track}
      aria-label="Series previous and next"
    >
      {prev && (
        <a class={styles.sibling} href={prev.href}>
          <span class:list={['text-mono-eyebrow', styles.dir]}>Previous</span>
          <span class:list={['text-body-small', styles.sibTitle]}>{prev.title}</span>
        </a>
      )}
      {next && (
        <a class={styles.sibling} href={next.href}>
          <span class:list={['text-mono-eyebrow', styles.dir]}>Next</span>
          <span class:list={['text-body-small', styles.sibTitle]}>{next.title}</span>
        </a>
      )}
    </nav>
  )
)}
