---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageFrame from '../components/shell/PageFrame.astro';
import PageIntro from '../components/ui/PageIntro.astro';
import FilterBar from '../components/ui/FilterBar.astro';
import PostCard from '../components/ui/PostCard.astro';
import TwoColumn from '../components/ui/TwoColumn.astro';
import SeriesNav from '../components/ui/SeriesNav.astro';
import { getFeedPosts, getFeaturedSeries, getPostsByType, getSeriesNavParts } from '../lib/content';
import styles from './index.module.css';

const posts = await getFeedPosts();
const featured = await getFeaturedSeries();
const featuredParts = featured ? await getSeriesNavParts(featured.series.id) : [];
const latestTils = (await getPostsByType('til')).slice(0, 2);
---

<BaseLayout title="emad/journal">
  <PageFrame>
    <TwoColumn>
      <PageIntro
        eyebrow="Notebook · CS & Security"
        title="Notes from learning in public"
        lead="Series, TILs, essays and build logs in one feed."
      />
      <FilterBar pathname="/" typeFilter={true} trackFilter="home" />
      <div>
        {posts.map((post) => (
          <PostCard post={post} />
        ))}
        <p class="text-mono-meta" data-feed-empty hidden>
          No matching posts. <a href="/">Clear filters</a>
        </p>
      </div>
      <Fragment slot="aside">
        <section class={styles.asideBlock}>
            <h2 class:list={['text-mono-eyebrow', styles.asideTitle]}>Browse</h2>
          <ul class={styles.sectionList}>
            <li><a class="text-link" href="/series"><span>Series</span><span aria-hidden="true">→</span></a></li>
            <li><a class="text-link" href="/tils"><span>TILs</span><span aria-hidden="true">→</span></a></li>
            <li><a class="text-link" href="/essays"><span>Essays</span><span aria-hidden="true">→</span></a></li>
            <li><a class="text-link" href="/build-logs"><span>Build logs</span><span aria-hidden="true">→</span></a></li>
          </ul>
        </section>
        {featured && (
          <section class={styles.asideBlock}>
            <h2 class:list={['text-mono-eyebrow', styles.asideTitle]}>Current series</h2>
            <SeriesNav series={featured.series} parts={featuredParts} variant="list" />
          </section>
        )}
        {latestTils.length > 0 && (
          <section class={styles.asideBlock}>
            <h2 class:list={['text-mono-eyebrow', styles.asideTitle]}>Latest TILs</h2>
            <div>
              {latestTils.map((post) => (
                <PostCard post={post} headingLevel="h3" />
              ))}
            </div>
          </section>
        )}
      </Fragment>
    </TwoColumn>
  </PageFrame>
</BaseLayout>
