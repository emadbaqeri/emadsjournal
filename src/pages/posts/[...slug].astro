---
import PostLayout from '../../layouts/PostLayout.astro';
import {
  getPosts,
  getPostsInSeries,
  getSeriesEntries,
  getMoreTils,
  type Post,
  type SeriesEntry,
} from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  const allSeries = await getSeriesEntries();
  return Promise.all(
    posts.map(async (post) => {
      const series = post.data.series
        ? allSeries.find((entry) => entry.id === post.data.series?.id)
        : undefined;
      const seriesParts = series ? await getPostsInSeries(series.id) : [];
      const moreTils = post.data.type === 'til' ? await getMoreTils(post) : [];
      return {
        params: { slug: post.id },
        props: { post, series, seriesParts, moreTils },
      };
    }),
  );
}

interface Props {
  post: Post;
  series?: SeriesEntry;
  seriesParts: Post[];
  moreTils: Post[];
}

const { post, series, seriesParts, moreTils } = Astro.props;
---

<PostLayout post={post} series={series} seriesParts={seriesParts} moreTils={moreTils} />
