---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageFrame from '../../components/shell/PageFrame.astro';
import PageIntro from '../../components/ui/PageIntro.astro';
import FilterBar from '../../components/ui/FilterBar.astro';
import PostCard from '../../components/ui/PostCard.astro';
import TwoColumn from '../../components/ui/TwoColumn.astro';
import Callout from '../../components/ui/Callout.astro';
import { getFeedPosts, uniqueTags } from '../../lib/content';

const posts = await getFeedPosts();
const tags = uniqueTags(posts);
---

<BaseLayout title="Posts · emad/journal">
  <PageFrame>
    <TwoColumn>
      <PageIntro
        eyebrow="Posts · Archive"
        title="All posts"
        lead="Everything published, newest first."
      />
      <FilterBar pathname="/posts" tags={tags} />
      <div>
        {posts.map((post) => (
          <PostCard post={post} />
        ))}
        <p class="text-mono-meta" data-feed-empty hidden>
          No matching posts. <a href="/posts">Clear filters</a>
        </p>
      </div>
      <Fragment slot="aside">
        <Callout kind="note" title="About the archive">
          This list is every published post. Use a tag to narrow it.
        </Callout>
      </Fragment>
    </TwoColumn>
  </PageFrame>
</BaseLayout>
