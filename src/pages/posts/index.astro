---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageFrame from '../../components/shell/PageFrame.astro';
import { getFeedPosts, getPostPath } from '../../lib/content';

const posts = await getFeedPosts();
---

<BaseLayout title="Posts · emad/journal">
  <PageFrame>
    <p class="text-mono-eyebrow">Posts · Archive</p>
    <h1 class="text-heading-h1">All posts</h1>
    <ul>
      {
        posts.map((post) => (
          <li data-track={post.data.track}>
            <a href={getPostPath(post)}>{post.data.title}</a>
            <time datetime={post.data.publishedAt.toISOString()}>
              {post.data.publishedAt.toISOString().slice(0, 10)}
            </time>
          </li>
        ))
      }
    </ul>
  </PageFrame>
</BaseLayout>
